<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:d="jelly:define" xmlns:l="/lib/layout" xmlns:t="/lib/hudson" xmlns:f="/lib/form">
    <f:entry title="Scan Source" field="scanSource">
        <f:checkbox />
    </f:entry>
    <f:entry title="Scan Tests" field="scanTest">
        <f:checkbox />
    </f:entry>
    <f:entry title="Scan Target" field="scanTarget">
        <f:checkbox />
    </f:entry>
    <f:entry title="Scan Console Output" field="scanConsoleOutput">
        <f:checkbox />
    </f:entry>
    <f:entry title="Scan Environment Variables" field="scanEnvironmentVariables">
        <f:checkbox />
    </f:entry>
</j:jelly>
